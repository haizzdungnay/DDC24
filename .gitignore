# Build / artifacts
.playwright-cli/
# Cache biên dịch tăng dần của tsc — sinh lại được, và commit vào sẽ tạo
# xung đột ở mọi nhánh vì nội dung phụ thuộc thứ tự build của từng máy.
*.tsbuildinfo
build/
build_*/
build_core_check/
build_iobus_check/
dist/
*.o
*.elf
*.bin
*.hex
*.map
__pycache__/
*.pyc
.venv/
.venv-bacnet/
venv/
node_modules/
.svelte-kit/

# OTA / firmware packages
*.kxpkg

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Logs / local data
*.log
/data/
/RUN_PROJECT.md
src/frontend/.env
src/frontend/.env.local

# Dev/runtime SQLite của mkddc-web (không commit)
services/web/.dev-config/
web/backend/.dev-config/
web/backend/mkddc-web
web/backend/mkddc-web.exe
web/backend/mkddc-web-*
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Security scan artifacts
gitleaks-report.json

# Runtime/test logs (local, không commit)
logs/*
!logs/README.md


# Local backup of stale untracked files (manual cleanup)
/.untracked_backup_2026-06-15/

# Bộ hồ sơ bàn giao auditor — bản sao chụp tài liệu đã có sẵn trong docs/,
# giữ cục bộ để gửi ra ngoài, không đẩy lên GitHub tránh trùng lặp nội dung.
/audit-handover-*/
