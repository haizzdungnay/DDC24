{
  "name": "mk-ddc-24-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:programming-contracts && tsc --noEmit && vite build",
    "generate:programming-errors": "python3 ../../scripts/generate_programming_errors.py",
    "check:programming-errors": "python3 ../../scripts/generate_programming_errors.py --check",
    "check:programming-contracts": "npm run check:programming-errors && npm run check:programming-api",
    "generate:programming-api": "node scripts/generate-programming-client.mjs",
    "check:programming-api": "node scripts/generate-programming-client.mjs --check",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest --run --environment jsdom src",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "yaml": "2.4.2"
  }
}
