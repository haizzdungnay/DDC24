{
  "name": "mk-ddc-24-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:programming-contracts && tsc --noEmit && vite build && npm run check:bundle-budget",
    "build:release": "VITE_PROGRAMMING_REV_A=1 npm run build",
    "build:foxlinx": "npm run build:release",
    "generate:programming-errors": "python3 ../../scripts/generate_programming_errors.py",
    "check:programming-errors": "python3 ../../scripts/generate_programming_errors.py --check",
    "check:programming-contracts": "npm run check:programming-errors && npm run check:programming-api && npm run check:programming-fbd && npm run check:programming-st-keywords && npm run check:programming-st-keyboard",
    "check:programming-st-keywords": "python3 ../../scripts/generate_st_reserved_words.py --check",
    "check:programming-fbd": "python3 ../../scripts/verify_programming_fbd_contract.py --self-test",
    "check:programming-st-keyboard": "python3 ../../scripts/verify_programming_st_keyboard.py --self-test",
    "generate:programming-api": "node scripts/generate-programming-client.mjs",
    "check:programming-api": "node scripts/generate-programming-client.mjs --check",
    "lint": "eslint src --max-warnings=0 && npm run check:ui-strings",
    "lint:e2e": "eslint e2e --max-warnings=0",
    "check:ui-strings": "python3 ../../scripts/check_ui_strings.py",
    "test": "vitest --run --environment jsdom src",
    "test:e2e": "playwright test",
    "test:e2e:programming-real": "playwright test --config playwright.programming-real.config.ts",
    "test:e2e:programming-target": "playwright test --config playwright.programming-target.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "preview": "vite preview --host 0.0.0.0",
    "build:e2e": "VITE_DDC_MODE=live VITE_AUTH_MODE=mock VITE_HISTORIAN_V2_TRENDS=1 VITE_PROGRAMMING_REV_A=1 vite build",
    "build:e2e:programming-real": "vite build",
    "check:bundle-budget": "python3 ../../scripts/verify_programming_bundle_budget.py --increment r3"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "yaml": "2.4.2"
  }
}
