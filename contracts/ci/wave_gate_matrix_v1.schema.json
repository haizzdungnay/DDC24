{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mekong-hcm.local/contracts/ci/wave_gate_matrix_v1.schema.json",
  "title": "Ma trận cổng theo Wave v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrixId", "schemaVersion", "description", "evidenceLevels", "gates", "waves"],
  "properties": {
    "$schema": { "type": "string" },
    "matrixId": { "const": "MKDDC-WAVE-GATE-MATRIX-V1" },
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "evidenceLevels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HOST", "CI", "TARGET", "HIL"],
      "properties": {
        "HOST": { "type": "string", "minLength": 1 },
        "CI": { "type": "string", "minLength": 1 },
        "TARGET": { "type": "string", "minLength": 1 },
        "HIL": { "type": "string", "minLength": 1 }
      }
    },
    "gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gate" } },
    "waves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/wave" } }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidenceLevel", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
        "evidenceLevel": { "enum": ["HOST", "CI", "TARGET", "HIL"] },
        "description": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requiresResource": { "type": "string", "minLength": 1 },
        "runbook": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "pattern": "^T59-[0-9]{3}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "evidenceLevel": { "const": "HOST" } } },
          "then": { "required": ["command"], "not": { "required": ["requiresResource"] } }
        },
        {
          "if": { "properties": { "evidenceLevel": { "enum": ["CI", "TARGET", "HIL"] } } },
          "then": {
            "required": ["requiresResource", "runbook", "owner"],
            "not": { "required": ["command"] }
          }
        }
      ]
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave", "title", "gates"],
      "properties": {
        "wave": { "pattern": "^W[0-7]$" },
        "title": { "type": "string", "minLength": 1 },
        "gates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
