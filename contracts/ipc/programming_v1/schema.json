{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkddc.local/contracts/ipc/programming_v1/schema.json",
  "title": "MK-DDC-24 Programming IPC v1",
  "description": "Schema logic cho CBOR array sau length-prefix uint32 little-endian.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "uuidBytes": {
      "type": "string",
      "contentEncoding": "base64",
      "x-cbor-type": "byte-string",
      "x-byte-length": 16
    },
    "nullableUuidBytes": {
      "type": [
        "string",
        "null"
      ],
      "contentEncoding": "base64",
      "x-cbor-type": "byte-string",
      "x-byte-length": 16
    },
    "sha256Bytes": {
      "type": "string",
      "contentEncoding": "base64",
      "x-cbor-type": "byte-string",
      "x-byte-length": 32
    },
    "payloadBytes": {
      "type": "string",
      "contentEncoding": "base64",
      "x-cbor-type": "byte-string",
      "maxLength": 43692,
      "description": "CBOR canonical action payload, tối đa 32 KiB trước base64."
    },
    "runtimeSignalPayload": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "description": "Published Signal do Core chụp từ StSignalBus; value null khi valid=false.",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "title": "name"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "title": "producerProgramId"
        },
        {
          "type": "string",
          "enum": [
            "BOOL",
            "INT",
            "DINT",
            "UINT",
            "REAL",
            "TIME"
          ],
          "title": "dataType"
        },
        {
          "type": [
            "boolean",
            "integer",
            "number",
            "null"
          ],
          "title": "value"
        },
        {
          "type": "boolean",
          "title": "valid"
        },
        {
          "type": "string",
          "enum": [
            "GOOD",
            "UNCERTAIN",
            "BAD"
          ],
          "title": "quality"
        },
        {
          "type": "string",
          "enum": [
            "FRESH",
            "STALE_HELD",
            "STALE_FALLBACK",
            "UNAVAILABLE",
            "NOT_DECLARED"
          ],
          "title": "freshness"
        },
        {
          "type": "string",
          "enum": [
            "WAIT",
            "HOLD_LAST",
            "USE_FALLBACK",
            "SAFE_STATE"
          ],
          "title": "stalePolicy"
        },
        {
          "type": "integer",
          "minimum": 10,
          "maximum": 150000,
          "title": "freshnessMs"
        },
        {
          "type": "integer",
          "minimum": 0,
          "title": "publishedAtMonoNs"
        },
        {
          "type": "integer",
          "minimum": 0,
          "title": "generation"
        }
      ]
    },
    "runtimeStatusPayloadV3": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "string",
          "enum": [
            "GRAPH_ONLY",
            "PROGRAM_ONLY"
          ],
          "title": "producerMode"
        },
        {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "title": "activeRevisionId"
        },
        {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "title": "lkgRevisionId"
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "title": "activeOverrideIds"
        },
        {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/runtimeSignalPayload"
          },
          "title": "signals"
        }
      ]
    },
    "activateProgramIntent": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "ADR-062 — intent Enable/Disable ĐÃ LƯU của một Program, web chụp từ `program_runtime_intents` lúc kích hoạt. Không phải lệnh vận hành mới và không tạo audit PROGRAM_ENABLE.",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "instanceId"
        },
        {
          "type": "boolean",
          "title": "desiredEnabled"
        }
      ]
    },
    "activatePayload": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "description": "Payload ACTIVATE. Phần tử thứ năm `programIntents` là tuỳ chọn (ADR-062): vắng mặt thì Core dùng luật T59-305/405 cũ. Web chỉ gửi nó khi CAPABILITIES công bố `ACTIVATE_PROGRAM_INTENTS`.",
      "prefixItems": [
        {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "title": "expectedActiveRevisionId"
        },
        {
          "type": "string",
          "maxLength": 128,
          "title": "stagedToken"
        },
        {
          "type": "string",
          "const": "PROGRAM_ONLY",
          "title": "cutover"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "title": "planHash"
        },
        {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/activateProgramIntent"
          },
          "title": "programIntents"
        }
      ]
    },
    "capabilitiesPayload": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "description": "Payload response CAPABILITIES. Phần tử thứ năm `features` (ADR-062) là danh sách tính năng Core hỗ trợ; Core cũ trả 4 phần tử và phải được đọc là không có tính năng nào.",
      "prefixItems": [
        {
          "type": "string",
          "const": "MK-DDC-24-REV-A",
          "title": "profile"
        },
        {
          "type": "integer",
          "minimum": 1,
          "title": "maxFrameBytes"
        },
        {
          "type": "integer",
          "minimum": 1,
          "title": "maxQueueDepth"
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "title": "allowedPeriodMs"
        },
        {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ACTIVATE_PROGRAM_INTENTS"
            ]
          },
          "title": "features"
        }
      ]
    },
    "request": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {
          "type": "integer",
          "const": 1,
          "title": "protocolMajor"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "title": "protocolMinor"
        },
        {
          "type": "string",
          "const": "1.0",
          "title": "schemaVersion"
        },
        {
          "$ref": "#/$defs/uuidBytes",
          "title": "requestId"
        },
        {
          "$ref": "#/$defs/nullableUuidBytes",
          "title": "operationId"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "title": "controllerId"
        },
        {
          "type": "string",
          "maxLength": 128,
          "title": "actorId"
        },
        {
          "type": "integer",
          "minimum": 1,
          "title": "deadlineMonoNs"
        },
        {
          "$ref": "#/$defs/sha256Bytes",
          "title": "payloadHash"
        },
        {
          "type": "string",
          "enum": [
            "CAPABILITIES",
            "STATUS",
            "STAGE",
            "ACTIVATE",
            "OPERATION_STATUS",
            "RESTORE",
            "TRACE_START",
            "RETAIN_RESET",
            "RECOVERY_RESET",
            "SET_PROGRAM_ENABLED",
            "TRACE_STOP",
            "TRACE_READ"
          ],
          "title": "action"
        },
        {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "correlationId"
        },
        {
          "$ref": "#/$defs/payloadBytes",
          "title": "payload"
        }
      ]
    },
    "response": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "prefixItems": [
        {
          "type": "integer",
          "const": 1,
          "title": "protocolMajor"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "title": "protocolMinor"
        },
        {
          "type": "string",
          "const": "1.0",
          "title": "schemaVersion"
        },
        {
          "$ref": "#/$defs/uuidBytes",
          "title": "requestId"
        },
        {
          "$ref": "#/$defs/nullableUuidBytes",
          "title": "operationId"
        },
        {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "title": "correlationId"
        },
        {
          "type": "string",
          "enum": [
            "OK",
            "STAGED",
            "ACCEPTED",
            "REJECTED",
            "UNAVAILABLE",
            "BUSY"
          ],
          "title": "result"
        },
        {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "title": "activeRevisionId"
        },
        {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "title": "lkgRevisionId"
        },
        {
          "type": "boolean",
          "title": "keepsRunning"
        },
        {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "title": "detailCode"
        },
        {
          "type": "string",
          "maxLength": 128,
          "title": "component"
        },
        {
          "$ref": "#/$defs/payloadBytes",
          "title": "payload"
        }
      ]
    }
  },
  "x-mkddc-action-payloads": {
    "CAPABILITIES": {
      "responsePayload": {
        "$ref": "#/$defs/capabilitiesPayload"
      },
      "backwardCompatibleReader": "Web đọc phần tử thứ năm nếu có; 4 phần tử, lỗi IPC hoặc payload không đọc được đều nghĩa là Core KHÔNG có tính năng nào, và web phải gửi ACTIVATE 4 phần tử."
    },
    "STATUS": {
      "sinceProtocolMinor": 3,
      "responsePayload": {
        "$ref": "#/$defs/runtimeStatusPayloadV3"
      },
      "backwardCompatibleReader": "Minor 2 có array 4 phần tử; BE minor 3 phải đọc được và coi Published Signal là UNAVAILABLE."
    },
    "OPERATION_STATUS": {
      "sinceProtocolMinor": 3,
      "responsePayload": {
        "$ref": "#/$defs/runtimeStatusPayloadV3"
      }
    },
    "ACTIVATE": {
      "requestPayload": {
        "$ref": "#/$defs/activatePayload"
      },
      "featureGate": "ACTIVATE_PROGRAM_INTENTS",
      "decision": "ADR-062",
      "coreSemantics": "Core áp `programIntents` lên shadow sau COMMIT_INTENT và trước arm: false → Disabled; true → Enabled theo thứ tự gói trong trần maxProgramsEnabled, phần vượt trần giữ Disabled và không chặn kích hoạt; Program không có phần tử giữ luật T59-305/405; instance không có trong gói bị bỏ qua; sai kiểu, quá 32, id sai định dạng hoặc trùng → REJECTED/IPC-PAYLOAD trước mọi thay đổi.",
      "backwardCompatibleReader": "Core mới nhận cả 4 và 5 phần tử. Core cũ chỉ nhận 4 phần tử, nên web không bao giờ gửi 5 phần tử khi CAPABILITIES không công bố tính năng. protocolMinor giữ nguyên vì web cũ từ chối response có minor cao hơn."
    }
  },
  "x-mkddc-actions": {
    "description": "Trạng thái handler của từng action. Enum wire phải giữ ổn định (gỡ giá trị enum là breaking change cho cả hai codec), nên action chưa có handler được khai NOT_IMPLEMENTED kèm chủ sở hữu và detail code trả về. `scripts/verify_programming_ipc_actions.py` kiểm hai chiều: IMPLEMENTED phải có nhánh dispatch thật trong Core, NOT_IMPLEMENTED thì không được có.",
    "notImplementedDetailCode": "IPC-ACTION-NOT-IMPLEMENTED",
    "entries": [
      {
        "action": "CAPABILITIES",
        "handlerStatus": "IMPLEMENTED",
        "mutation": false,
        "owner": "Core"
      },
      {
        "action": "STATUS",
        "handlerStatus": "IMPLEMENTED",
        "mutation": false,
        "owner": "Core"
      },
      {
        "action": "STAGE",
        "handlerStatus": "IMPLEMENTED",
        "mutation": true,
        "owner": "Core"
      },
      {
        "action": "ACTIVATE",
        "handlerStatus": "IMPLEMENTED",
        "mutation": true,
        "owner": "Core"
      },
      {
        "action": "OPERATION_STATUS",
        "handlerStatus": "IMPLEMENTED",
        "mutation": false,
        "owner": "Core"
      },
      {
        "action": "RESTORE",
        "handlerStatus": "IMPLEMENTED",
        "mutation": true,
        "owner": "Core"
      },
      {
        "action": "RETAIN_RESET",
        "handlerStatus": "IMPLEMENTED",
        "mutation": true,
        "owner": "Core"
      },
      {
        "action": "RECOVERY_RESET",
        "handlerStatus": "IMPLEMENTED",
        "mutation": true,
        "owner": "Core"
      },
      {
        "action": "TRACE_START",
        "handlerStatus": "IMPLEMENTED",
        "mutation": true,
        "owner": "Core"
      },
      {
        "action": "SET_PROGRAM_ENABLED",
        "handlerStatus": "IMPLEMENTED",
        "mutation": true,
        "owner": "Core"
      },
      {
        "action": "TRACE_STOP",
        "handlerStatus": "IMPLEMENTED",
        "mutation": true,
        "owner": "Core"
      },
      {
        "action": "TRACE_READ",
        "handlerStatus": "IMPLEMENTED",
        "mutation": false,
        "owner": "Core"
      }
    ]
  }
}
