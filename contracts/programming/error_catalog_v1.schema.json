{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mkddc.local/contracts/programming/error_catalog_v1.schema.json",
 "title": "MK-DDC-24 Programming public error catalog v1",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "catalogVersion",
  "unknownFallbackCode",
  "publicErrors",
  "componentDetails"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "schemaVersion": {
   "const": 1
  },
  "catalogVersion": {
   "type": "string",
   "pattern": "^1\\.[0-9]+\\.[0-9]+$"
  },
  "unknownFallbackCode": {
   "type": "string",
   "pattern": "^PRG-ERR-[A-Z0-9-]+$"
  },
  "publicErrors": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "symbol",
     "code",
     "ownerComponent",
     "statusClass",
     "httpStatuses",
     "retryable",
     "keepsRunningRevision",
     "messageKey",
     "allowedArgs"
    ],
    "properties": {
     "symbol": {
      "type": "string",
      "pattern": "^Err[A-Za-z0-9]+$"
     },
     "code": {
      "type": "string",
      "pattern": "^PRG-ERR-[A-Z0-9-]+$"
     },
     "ownerComponent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
     },
     "statusClass": {
      "enum": [
       "REQUEST",
       "NOT_FOUND",
       "CONFLICT",
       "VALIDATION",
       "OPERATION",
       "UNAVAILABLE"
      ],
      "description": "`NOT_FOUND` từng được dùng bởi PRG-ERR-NOT-FOUND-001 nhưng thiếu trong enum: schema này chưa bao giờ được generator thi hành nên drift tồn tại im lặng. T59-004 bổ sung giá trị và bật validate schema trong generator."
     },
     "httpStatuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "type": "integer",
       "minimum": 400,
       "maximum": 599
      }
     },
     "retryable": {
      "type": "boolean"
     },
     "keepsRunningRevision": {
      "type": "boolean"
     },
     "messageKey": {
      "type": "string",
      "pattern": "^programming\\.[A-Za-z0-9_.-]+$"
     },
     "allowedArgs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
      }
     }
    }
   }
  },
  "componentDetails": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "component",
     "detailCode",
     "publicCode"
    ],
    "properties": {
     "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
     },
     "detailCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,127}$"
     },
     "publicCode": {
      "type": "string",
      "pattern": "^PRG-ERR-[A-Z0-9-]+$"
     },
     "contractOnly": {
      "const": true,
      "description": "Detail code chỉ tồn tại trong contract/test codec, không có emitter production. Phải khai tường minh để guard hai chiều không im lặng bỏ qua."
     }
    }
   }
  }
 }
}
