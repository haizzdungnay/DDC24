{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mekong-hcm.local/contracts/programming/rev_a_profile_v1.schema.json",
  "title": "Profile Programming Rev A v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "profileCode",
    "version",
    "task",
    "resources",
    "languages",
    "types",
    "pointKinds",
    "coreLibrary",
    "integrityMode"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "profileId": { "const": "revA-1t-1-5-30" },
    "profileCode": { "const": 1 },
    "version": { "$ref": "#/$defs/version" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTasks", "maxProgramsPerTask", "maxProgramsTotal", "allowedPeriodMs"],
      "properties": {
        "maxTasks": { "const": 1 },
        "maxProgramsPerTask": { "const": 1 },
        "maxProgramsTotal": { "const": 1 },
        "allowedPeriodMs": {
          "type": "array",
          "prefixItems": [{ "const": 1000 }, { "const": 5000 }, { "const": 30000 }],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSourceBytes", "maxVariables", "maxStatements", "maxFbdBlocks",
        "maxFbdConnections", "maxArtifactBytes", "maxInstructions", "maxSlots",
        "maxWritableSlots", "maxConstants", "maxFunctionBlocks", "maxBindings",
        "maxRetainVariables", "maxRetainBytes", "maxSections"
      ],
      "properties": {
        "maxSourceBytes": { "const": 65536 },
        "maxVariables": { "const": 512 },
        "maxStatements": { "const": 4096 },
        "maxFbdBlocks": { "const": 256 },
        "maxFbdConnections": { "const": 512 },
        "maxArtifactBytes": { "const": 1048576 },
        "maxInstructions": { "const": 4096 },
        "maxSlots": { "const": 1024 },
        "maxWritableSlots": { "const": 512 },
        "maxConstants": { "const": 512 },
        "maxFunctionBlocks": { "const": 64 },
        "maxBindings": { "const": 256 },
        "maxRetainVariables": { "const": 128 },
        "maxRetainBytes": { "const": 4096 },
        "maxSections": { "const": 16 }
      }
    },
    "languages": {
      "type": "array",
      "prefixItems": [{ "const": "ST" }, { "const": "FBD" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "types": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/typeDescriptor" }
    },
    "pointKinds": {
      "type": "array",
      "prefixItems": [{ "const": "LOCAL" }, { "const": "VP" }, { "const": "MB_RTU" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "coreLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "functions"],
      "properties": {
        "version": { "const": "rev-a.1" },
        "functions": {
          "type": "array",
          "minItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "integrityMode": { "const": "HASH_ONLY" }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "const": 0 }
      }
    },
    "typeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "widthBits", "wireCode", "conversion"],
      "properties": {
        "name": { "enum": ["BOOL", "INT", "DINT", "UINT", "REAL", "TIME"] },
        "widthBits": { "enum": [1, 16, 32, 64] },
        "wireCode": { "type": "integer", "minimum": 1, "maximum": 255 },
        "conversion": { "const": "EXPLICIT_FAIL_CLOSED" }
      }
    }
  }
}
