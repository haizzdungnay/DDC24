{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mekong-hcm.local/contracts/programming/source_bundle_v1.schema.json",
  "title": "MK-DDC-24 Programming source-only bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleType", "targetProfile", "sourceProject", "revisionIds", "selectedRevisionId", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "bundleType": { "const": "MKDDC_PROGRAMMING_SOURCE_ONLY" },
    "targetProfile": { "const": "MKDDC24_REVA" },
    "sourceProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "name", "description"],
      "properties": {
        "projectId": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 2048 }
      }
    },
    "revisionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "selectedRevisionId": { "$ref": "#/$defs/uuid" },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteSize", "kind", "revisionId"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^revisions/[0-9a-f-]+/(manifest\\.json|objects/[a-z_]+/[0-9a-f-]+\\.json)$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 2, "maximum": 262144 },
        "kind": {
          "type": "string",
          "enum": ["REVISION_MANIFEST", "METADATA", "PROGRAM", "FUNCTION", "FUNCTION_BLOCK", "VARIABLE", "BINDING", "TASK"]
        },
        "revisionId": { "$ref": "#/$defs/uuid" },
        "objectId": { "$ref": "#/$defs/uuid" }
      }
    }
  },
  "x-mkddc-invariants": {
    "archive": "ZIP_STORE_ONLY_FIXED_TIMESTAMP_SORTED_PATHS",
    "manifestPath": "manifest.json",
    "maximumArchiveBytes": 4194304,
    "importResult": "NEW_PROJECT_NEW_DRAFT_ONLY",
    "forbidden": ["ARTIFACT", "IR", "NATIVE", "CACHE", "SECRET", "CREDENTIAL", "AUTO_CHECK", "AUTO_COMMISSION"]
  }
}
