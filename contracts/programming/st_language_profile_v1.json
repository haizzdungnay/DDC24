{
  "compilerVersion": "fwsom-st-1.2.0",
  "conformanceClaim": "IEC 61131-3-aligned subset. KHÔNG tuyên bố certified/compliant (ADR-020).",
  "deliberateExclusions": [
    {
      "authority": "ADR-054 phán quyết (3)",
      "construct": "FOR",
      "inIec": true,
      "kind": "statement",
      "reason": "P1 — mọi scan phải chấm dứt trong thời gian chặn trên biết trước. Vòng lặp có số vòng phụ thuộc dữ liệu làm WCET không tính được tĩnh, nên bị loại vì ràng buộc AN TOÀN của DDC, không phải vì thiếu trong IEC."
    },
    {
      "authority": "ADR-054 phán quyết (3)",
      "construct": "WHILE",
      "inIec": true,
      "kind": "statement",
      "reason": "P1 — như FOR: điều kiện dừng phụ thuộc dữ liệu runtime, WCET không chặn trên được."
    },
    {
      "authority": "ADR-054 phán quyết (3)",
      "construct": "REPEAT",
      "inIec": true,
      "kind": "statement",
      "reason": "P1 — như WHILE, thêm việc thân luôn chạy ít nhất một lần."
    },
    {
      "authority": "hệ quả của ADR-054 phán quyết (3)",
      "construct": "EXIT",
      "inIec": true,
      "kind": "statement",
      "reason": "Chỉ có nghĩa bên trong vòng lặp; không có vòng lặp thì không có gì để thoát."
    },
    {
      "authority": "ST_SUBSET_SPEC §5",
      "construct": "RETURN",
      "inIec": true,
      "kind": "statement",
      "reason": "Nhiều điểm thoát làm cây WCET rẽ nhánh không cần thiết; FUNCTION gán kết quả qua ô trả về mang tên hàm như IEC quy định."
    },
    {
      "authority": "ST_SUBSET_SPEC §4.2",
      "construct": "**",
      "inIec": true,
      "kind": "operator",
      "reason": "Luỹ thừa trên REAL không có chặn trên chi phí tất định trên FPU mềm của target, và không có ca dùng HVAC nào trong Rev A. Dùng phép nhân tường minh."
    },
    {
      "authority": "ADR-054 phán quyết (4)",
      "construct": "STRING",
      "inIec": true,
      "kind": "type",
      "reason": "P2 — độ dài biến kéo theo cấp phát động trong chu kỳ scan. Loại trừ tới khi có kiểu chuỗi độ dài cố định."
    },
    {
      "authority": "ADR-054 phán quyết (4)",
      "construct": "DATE",
      "inIec": true,
      "kind": "type",
      "reason": "P2 — lịch/múi giờ thuộc tầng Schedule, không thuộc ngôn ngữ điều khiển chu kỳ."
    },
    {
      "authority": "ADR-054 phán quyết (4)",
      "construct": "TOD",
      "inIec": true,
      "kind": "type",
      "reason": "P2 — thời điểm trong ngày phụ thuộc múi giờ và quy tắc đổi giờ, hai thứ thuộc tầng Schedule. Chương trình chu kỳ nhận thời gian đã quy đổi qua Point, không tự diễn giải lịch."
    },
    {
      "authority": "ADR-054 phán quyết (4)",
