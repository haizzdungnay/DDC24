+/* ---- T63-102 nhánh "seqlock_fail > 0" (ĐỀ XUẤT): retry ≤ 20 µs ---- */
+namespace {
+
+struct FakeSpinClock {
+    uint64_t now = 5000000ull;
+    uint64_t start = 5000000ull;
+    int relaxes = 0;
+    kx_io_shm_t* writer = nullptr;
+    int release_after_relaxes = -1;
+
+    static uint64_t now_ns(void* ctx) { return static_cast<FakeSpinClock*>(ctx)->now; }
+    static void relax(void* ctx)
+    {
+        auto* self = static_cast<FakeSpinClock*>(ctx);
+        self->now += 100ull;   /* mỗi vòng quay ≈ 100 ns (vDSO + copy) */
+        ++self->relaxes;
+        if (self->writer && self->relaxes == self->release_after_relaxes) KX_WRITE_END(self->writer);
+    }
+    SeqlockSpinPolicy policy()
+    {
+        SeqlockSpinPolicy p;
+        p.now_ns = &FakeSpinClock::now_ns;
+        p.relax = &FakeSpinClock::relax;
+        p.ctx = this;
+        return p;
+    }
+};
+
+} // namespace
+
+TEST(IobusReaderT63102, WriterHolding5usIsReadWithinSpinBudget)
+{
+    kx_io_shm_t shm = make_shm();
+    shm.iop_status = KX_IOP_NORMAL;
+    KX_WRITE_BEGIN(&shm);
+    FakeSpinClock clock;
+    clock.writer = &shm;
+    clock.release_after_relaxes = 50;   /* 50 × 100 ns = 5 µs */
+    SeqlockReadStats stats;
+    IoSnapshot out;
+    EXPECT_TRUE(IobusReader::read_from_within(&shm, &out, clock.policy(), &stats));
+    EXPECT_EQ(out.iop_status, KX_IOP_NORMAL);
+    EXPECT_EQ(stats.retries, 50u);
+    EXPECT_EQ(stats.failures, 0u);
+}
+
+TEST(IobusReaderT63102, StuckWriterFailsAtTwentyMicroseconds)
+{
+    kx_io_shm_t shm = make_shm();
+    KX_WRITE_BEGIN(&shm);
+    FakeSpinClock clock;
+    SeqlockReadStats stats;
+    IoSnapshot out;
+    EXPECT_FALSE(IobusReader::read_from_within(&shm, &out, clock.policy(), &stats));
+    EXPECT_GE(clock.now - clock.start, 20000ull);
+    EXPECT_LE(clock.now - clock.start, 20000ull + 100ull) << "trần ≤ 20 µs (+1 vòng quay)";
+    EXPECT_EQ(stats.failures, 1u);
+    EXPECT_FALSE(out.valid);
+}
+
+TEST(IobusReaderT63102, StuckWriterOnRealClockIsBounded)
+{
+    kx_io_shm_t shm = make_shm();
+    KX_WRITE_BEGIN(&shm);
+    IobusReader reader;
+    reader.attach_external(&shm);
+    IoSnapshot out;
+    struct timespec a{}, b{};
+    clock_gettime(CLOCK_MONOTONIC, &a);
+    EXPECT_FALSE(reader.read(&out));
+    clock_gettime(CLOCK_MONOTONIC, &b);
+    const uint64_t elapsed = static_cast<uint64_t>(b.tv_sec - a.tv_sec) * 1000000000ull +
+                             static_cast<uint64_t>(b.tv_nsec) - static_cast<uint64_t>(a.tv_nsec);
+    EXPECT_GE(elapsed, 20000ull);
+    EXPECT_LT(elapsed, 5000000ull) << "có giới hạn (trần thật 20 µs; dư cho lịch máy CI)";
+    EXPECT_EQ(reader.seqlock_stats().failures, 1u);
+    EXPECT_GE(reader.seqlock_stats().max_wait_ns, 20000u);
+}
