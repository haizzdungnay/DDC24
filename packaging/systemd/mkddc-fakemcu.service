# MK-DDC-24 — fake MCU process (lab only, không dùng production)
# Chỉ enable cùng với mkddc-pty + mkddc-iobus drop-in nomcu.conf
[Unit]
Description=MK-DDC-24 fake MCU — lab/no-MCU only
After=mkddc-pty.service
Requires=mkddc-pty.service
Before=mkddc-iobus.service

[Service]
Type=simple
User=mkddc
Group=mkddc
ExecStart=/usr/local/bin/mkddc-fakemcu --uart /tmp/mkddc-iop-b
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
