[Unit]
# Đóng finding F-01: trước đây applySystem() là stub nên mọi thay đổi
# BACnet/WiFi lưu từ trang settings/network chỉ ghi được xuống file mà không bao
# giờ có hiệu lực. Helper này là đường DUY NHẤT để web (chạy user mkddc,
# NoNewPrivileges) yêu cầu restart service, và nó chỉ chấp nhận các reload target
# đã allowlist cứng trong web/backend/reloadhelper_linux.go — client không gửi
# được tên unit tuỳ ý.
Description=MK-DDC-24 privileged service reload helper
After=local-fs.target
Before=mkddc-web-pi.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/mkddc-web/mkddc-web reload-helper-server
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/mkddc
# Helper chỉ gọi systemctl try-restart cho vài unit mkddc-*; không cần quyền
# mạng, không cần ghi cấu hình, không cần CAP_SYS_ADMIN.
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
