set(MKDDC_VERSION "0.1.0" CACHE STRING "Phiên bản sản phẩm")
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../.."
  OUTPUT_VARIABLE MKDDC_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT MKDDC_COMMIT)
  set(MKDDC_COMMIT "unknown")
else()
  execute_process(COMMAND git status --porcelain --untracked-files=normal
    WORKING_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../.."
    OUTPUT_VARIABLE MKDDC_WORKTREE_STATE OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(MKDDC_WORKTREE_STATE)
    string(APPEND MKDDC_COMMIT "-dirty")
  endif()
endif()
string(TIMESTAMP MKDDC_BUILD_UTC "%Y-%m-%dT%H:%M:%SZ" UTC)
set(MKDDC_TOOLCHAIN_TEXT "${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}")

function(mkddc_apply_provenance target)
  target_compile_definitions(${target} PRIVATE
    MKDDC_BUILD_VERSION="${MKDDC_VERSION}"
    MKDDC_GIT_COMMIT="${MKDDC_COMMIT}"
    MKDDC_BUILD_TIME="${MKDDC_BUILD_UTC}"
    MKDDC_TOOLCHAIN="${MKDDC_TOOLCHAIN_TEXT}")
endfunction()
