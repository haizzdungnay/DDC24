# MK-DDC-24 — mkddc-core unit (nội dung chốt: docs/03_implementation/07 §9)
# iobus tạo SHM → core chạy sau. Wants (không Requires): iobus restart không kéo core chết.
[Unit]
Description=MK-DDC-24 core service (point table, priority, safe-state)
After=mkddc-iobus.service
Wants=mkddc-iobus.service

[Service]
Type=notify
ExecStart=/usr/sbin/mkddc-core
ExecReload=/bin/kill -HUP $MAINPID
User=mkddc
Group=mkddc
RuntimeDirectory=mkddc
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
StateDirectory=mkddc
Restart=always
RestartSec=2
# WatchdogSec theo ADR-028, bám base step nền tảng và LOẠI Task period khỏi
# công thức:
#   >= 2 x base_step_max + WCET_base_step(p99.9, target, SCHED_FIFO) + 1 s
# Base step Rev A có trần 2000 ms, nên 6 s là candidate hiện hành. Task
# Programming 30 s chỉ là cadence dispatch, không được nâng watchdog thành 61 s
# hoặc làm ScanLoop ngủ 30 s.
#
# Giá trị này là TARGET-PENDING tới khi đo lại trên target CÓ SCHED_FIFO: board hiện
# chạy SCHED_OTHER do drop-in nofifo.conf, nên số đo không đại diện cho cấu
# hình production. Xem docs/07_records/test-evidence/fw-som/.
#
# Kéo dài WatchdogSec KHÔNG làm chậm bảo vệ đầu ra: MCU tự ép AO/DO về an toàn
# sau 200 ms không nhận poll, độc lập hoàn toàn với SOM.
WatchdogSec=6
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80
LimitRTPRIO=85
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
