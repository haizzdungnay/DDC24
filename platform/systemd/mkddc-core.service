# MK-DDC-24 — mkddc-core unit (nội dung chốt: docs/03_implementation/07 §9)
# iobus tạo SHM → core chạy sau. Wants (không Requires): iobus restart không kéo core chết.
[Unit]
Description=MK-DDC-24 core service (point table, priority, safe-state)
After=mkddc-iobus.service
Wants=mkddc-iobus.service

[Service]
Type=notify
# Runtime coordinator/UDS khởi động trong GRAPH_ONLY; feature flag phía Web vẫn
# OFF mặc định nên chưa mở mutation user-facing trước release gate.
# ADR-052: khoá công khai của CHÍNH bo này vào tập khoá tin cậy. Thiếu file
# thì core dừng với lỗi cấu hình rõ ràng thay vì lặng lẽ chạy với ít khoá hơn.
ExecStart=/usr/sbin/mkddc-core --programming-runtime --st-trusted-key /data/mkddc/keys/device.pub
ExecReload=/bin/kill -HUP $MAINPID
User=mkddc
Group=mkddc
RuntimeDirectory=mkddc
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
StateDirectory=mkddc
Restart=always
RestartSec=2
# WatchdogSec theo ADR-028, bám base step nền tảng và LOẠI Task period khỏi
# công thức:
#   >= 2 x base_step_max + WCET_base_step(p99.9, target, SCHED_FIFO) + 1 s
# Base step Rev A có trần 2000 ms, nên 6 s là candidate hiện hành. ADR-061 hạ base
# step xuống 10 ms và giữ WatchdogSec=6 s (notify tối đa 1 lần/giây, 4.8). Chu kỳ
# Program 50 s chỉ là cadence dispatch, không được nâng watchdog theo nó hoặc làm
# ScanLoop ngủ theo nó.
#
# Giá trị này là TARGET-PENDING tới khi đo lại trên target CÓ SCHED_FIFO: board hiện
# chạy SCHED_OTHER do drop-in nofifo.conf, nên số đo không đại diện cho cấu
# hình production. Xem docs/07_records/test-evidence/fw-som/.
#
# Kéo dài WatchdogSec KHÔNG làm chậm bảo vệ đầu ra: MCU tự ép AO/DO về an toàn
# sau 200 ms không nhận poll, độc lập hoàn toàn với SOM.
WatchdogSec=6
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80
# ADR-061 4.11 (G2 tạm, chờ PREEMPT_RT): Core là tiến trình DUY NHẤT của sản phẩm
# chạy trên CPU3. Các service khác ghim CPU0–2 và irqbalance cấm CPU3 (drop-in
# `irqbalance-mkddc-rt.conf`). Đo trên Foxlinx 2026-09-26: dời IRQ khỏi CPU3 hạ
# jitter tối đa của tick 10 ms từ 470 xuống 173 µs (rảnh), nhưng CHƯA đạt C4
# (≤ 100 µs) — kernel non-RT vẫn là giới hạn.
CPUAffinity=3
LimitRTPRIO=85
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
