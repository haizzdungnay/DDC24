[Unit]
Description=MK-DDC-24 HMI Local Display
After=mkddc-web.service mkddc-iobus.service
Wants=mkddc-web.service

[Service]
Type=notify
ExecStart=/usr/sbin/mkddc-hmi
Restart=always
RestartSec=3
WatchdogSec=10
User=mkddc
Group=mkddc
SupplementaryGroups=video input
CapabilityBoundingSet=
NoNewPrivileges=yes
Environment=DISPLAY=
Environment=XDG_RUNTIME_DIR=/run/mkddc
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
