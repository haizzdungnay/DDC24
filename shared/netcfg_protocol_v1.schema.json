{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkddc.local/schemas/netcfg_protocol_v1.schema.json",
  "title": "MK-DDC network configuration protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "servers"],
      "properties": {
        "mode": { "enum": ["auto", "manual"] },
        "servers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "format": "ipv4", "maxLength": 15 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "auto" } } },
          "then": { "properties": { "servers": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "mode": { "const": "manual" } } },
          "then": { "properties": { "servers": { "minItems": 1 } } }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "mode"],
      "properties": {
        "interface": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,15}$" },
        "mode": { "enum": ["static", "dhcp"] },
        "ipv4": { "type": "string", "maxLength": 15 },
        "netmask": { "type": "string", "maxLength": 15 },
        "gateway": { "type": "string", "maxLength": 15 },
        "dns": { "$ref": "#/$defs/dns" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "static" } } },
          "then": { "required": ["ipv4", "netmask"] }
        },
        {
          "if": { "properties": { "mode": { "const": "dhcp" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["ipv4"] },
                { "required": ["netmask"] },
                { "required": ["gateway"] }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["dns"],
            "properties": {
              "dns": { "properties": { "mode": { "const": "auto" } } }
            }
          },
          "then": { "properties": { "mode": { "const": "dhcp" } } }
        }
      ]
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "link", "mode", "ipv4", "prefixLength", "gateway", "adminUp", "carrier", "reasonCode", "dnsServers"],
      "properties": {
        "interface": { "type": "string" },
        "link": { "enum": ["up", "down", "unknown"] },
        "mode": { "enum": ["static", "dhcp", "unknown"] },
        "ipv4": { "type": "string" },
        "prefixLength": { "type": "integer", "minimum": 0, "maximum": 32 },
        "gateway": { "type": "string" },
        "adminUp": { "type": "boolean" },
        "carrier": { "type": "boolean" },
        "reasonCode": { "enum": ["OK", "INTERFACE_NOT_FOUND", "KERNEL_STATE_UNAVAILABLE", "ADMIN_DOWN", "NO_CARRIER", "NO_ACTIVE_ADDRESS"] },
        "dnsServers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "ipv4", "maxLength": 15 }
        }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "mdnsName", "stable"],
      "properties": {
        "hostname": { "type": "string", "maxLength": 253 },
        "mdnsName": { "type": "string", "maxLength": 259 },
        "stable": { "type": "boolean" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "action"],
      "properties": {
        "version": { "const": 1 },
        "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
        "action": { "enum": ["status", "validate", "stage", "apply", "confirm", "rollback"] },
        "transactionId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
        "candidate": { "$ref": "#/$defs/candidate" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "result", "reasonCode", "state", "capabilities", "management"],
      "properties": {
        "version": { "const": 1 },
        "requestId": { "type": "string" },
        "result": { "enum": ["accepted", "rejected"] },
        "reasonCode": { "type": "string" },
        "message": { "type": "string" },
        "transactionId": { "type": "string" },
        "state": { "enum": ["idle", "staged", "applying", "awaiting_confirmation", "confirmed", "rolling_back", "rolled_back", "failed"] },
        "capabilities": { "const": ["dns", "management-hostname"] },
        "rollbackRemainingS": { "type": "integer", "minimum": 0, "maximum": 120 },
        "active": { "$ref": "#/$defs/active" },
        "configured": { "$ref": "#/$defs/candidate" },
        "pending": { "$ref": "#/$defs/candidate" },
        "management": { "$ref": "#/$defs/management" }
      }
    }
  }
}
