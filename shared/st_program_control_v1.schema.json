{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mekong-hcm.vn/schemas/st_program_control_v1.json",
  "title": "MK-DDC-24 FW SOM — Program Runtime control protocol v1",
  "description": "Hợp đồng JSON giữa BE SOM và Program Runtime trong mkddc-core. Nguồn thực thi: services/core/st/st_control_api.hpp. Bất biến: MỌI response đều có version/requestId/result; response lỗi luôn có errorCode và keepsRunningPackage.",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "version": { "const": 1 },
        "requestId": { "type": "string", "maxLength": 64,
          "description": "Được phản chiếu nguyên văn trong response, kể cả khi lỗi." },
        "action": {
          "enum": ["program_capabilities", "program_status", "program_stage",
                   "program_start", "program_stop", "program_enable",
                   "program_disable", "program_reset", "program_rollback"]
        },
        "instanceId": { "type": "string", "maxLength": 64,
          "description": "Bắt buộc với mọi action trừ program_capabilities và program_status." },
        "artifact": { "type": "string",
          "description": "Chỉ dùng với program_stage. Artifact MKDDCIR1 mã hoá base64, tối đa 1 MiB sau giải mã." }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["version", "requestId", "result"],
      "properties": {
        "version": { "const": 1 },
        "requestId": { "type": "string" },
        "result": { "enum": ["ok", "error"] },
        "errorCode": {
          "enum": ["API-E-001", "API-E-002", "API-E-003", "API-E-004",
                   "API-E-005", "API-E-006", "API-E-007"],
          "description": "API-E-001 bad request · 002 unknown action · 003 unknown instance · 004 bad transition · 005 bad artifact · 006 activation failed · 007 internal"
        },
        "message": { "type": "string" },
        "keepsRunningPackage": { "type": "boolean",
          "description": "true = chương trình đang chạy KHÔNG bị ảnh hưởng. BE dùng cờ này để quyết định có báo động hay không." },
        "detailCode": { "type": "string",
          "description": "Mã chi tiết từ tầng dưới, ví dụ IR-E-005 của loader." },
        "state": { "$ref": "#/$defs/programState" },
        "appliedAt": { "enum": ["next_tick_boundary"],
          "description": "program_stage: activation áp tại ranh giới tick kế, KHÔNG phải ngay lập tức." },
        "artifactBytes": { "type": "integer", "minimum": 0 },
        "interfaceVersion": { "type": "integer" },
        "artifactSchemaVersion": { "type": "integer" },
        "compilerProfile": { "type": "integer" },
        "targetAbi": { "type": "integer" },
        "compilerVersion": { "type": "string" },
        "maxArtifactBytes": { "type": "integer" },
        "maxTasks": { "type": "integer" },
        "maxProgramsPerTask": { "type": "integer" },
        "baseTickMs": { "type": "integer" },
        "anyForcingSafeState": { "type": "boolean" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
      },
      "additionalProperties": false
    },
    "programState": {
      "enum": ["EMPTY", "STAGED", "VALIDATED", "READY", "ACTIVE", "RUNNING",
               "STOPPED", "DISABLED", "FAULTED", "ROLLED_BACK", "REJECTED"]
    },
    "task": {
      "type": "object",
      "required": ["taskId", "priority", "periodMs", "programs"],
      "properties": {
        "taskId": { "type": "string" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 7 },
        "periodMs": { "type": "integer" },
        "budgetMs": { "type": "integer" },
        "enabled": { "type": "boolean" },
        "runCount": { "type": "integer" },
        "lastExecNs": { "type": "integer" },
        "maxExecNs": { "type": "integer" },
        "overrunTotal": { "type": "integer" },
        "overrunConsecutive": { "type": "integer" },
        "overrunThreshold": { "type": "integer" },
        "forcingSafeState": { "type": "boolean" },
        "programs": { "type": "array", "items": { "$ref": "#/$defs/program" } }
      },
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "required": ["instanceId", "state"],
      "properties": {
        "instanceId": { "type": "string" },
        "taskId": { "type": "string" },
        "order": { "type": "integer" },
        "state": { "$ref": "#/$defs/programState" },
        "enabled": { "type": "boolean" },
        "runCount": { "type": "integer" },
        "faultCount": { "type": "integer" },
        "hasLastKnownGood": { "type": "boolean" },
        "hasRetain": { "type": "boolean" },
        "programName": { "type": ["string", "null"] },
        "artifactSha256": { "type": ["string", "null"],
          "description": "base64 của SHA-256 artifact đang chạy. BE dùng để xác minh cái đang chạy đúng là cái mình gửi." },
        "lastFault": {
          "oneOf": [
            { "type": "null" },
            { "type": "object",
              "required": ["code", "pc", "line"],
              "properties": {
                "code": { "type": "string", "description": "ST-RT-*" },
                "pc": { "type": "integer" },
                "line": { "type": "integer", "description": "Dòng trong source ST gốc." }
              },
              "additionalProperties": false }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
