# Demo runs without hardware.
VITE_DDC_MODE=demo
VITE_AUTH_MODE=mock

# Demo keeps legacy generated Trends. Live builds default to v2 after activation;
# set 0 explicitly only for a rollback window.
VITE_HISTORIAN_V2_TRENDS=0

# Product/version fallback shown before live backend status arrives.
VITE_PRODUCT_CODE=DDC24
VITE_PRODUCT_MODEL=DDC24
VITE_DEVICE_NAME=DDC24
VITE_DEVICE_SERIAL=DDC24
# VITE_FIRMWARE_VERSION=0.1.0-be-b5

# Local dev against SOM through Vite proxy:
# VITE_DDC_MODE=live
# VITE_AUTH_MODE=none
# VITE_PROXY_TARGET=https://113.20.115.110:8443

# Browser-direct mode if backend enables CORS:
# VITE_API_ORIGIN=https://113.20.115.110:8443
# VITE_WS_ORIGIN=wss://113.20.115.110:8443
