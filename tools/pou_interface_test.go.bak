		},
	}
	if !reflect.DeepEqual(got, want) {
		t.Fatalf("extractPouInterface() = %+v, want %+v", got, want)
	}
}

func TestExtractPouInterface_JSONShape(t *testing.T) {
	// 1. Empty inputs -> {"inputs":[]}
	empty := pouInterface{Inputs: []pouInterfacePin{}}
	rawEmpty, err := json.Marshal(empty)
	if err != nil {
		t.Fatal(err)
	}
	if string(rawEmpty) != `{"inputs":[]}` {
		t.Fatalf("marshal empty = %s, want %s", string(rawEmpty), `{"inputs":[]}`)
	}

	// 2. Full interface
	full := pouInterface{
		Inputs:     []pouInterfacePin{{Name: "pv", Type: "REAL"}},
		Outputs:    []pouInterfacePin{{Name: "out", Type: "BOOL"}},
		ReturnType: "REAL",
	}
	rawFull, err := json.Marshal(full)
	if err != nil {
		t.Fatal(err)
	}
	wantFull := `{"inputs":[{"name":"pv","type":"REAL"}],"outputs":[{"name":"out","type":"BOOL"}],"returnType":"REAL"}`
	if string(rawFull) != wantFull {
		t.Fatalf("marshal full = %s, want %s", string(rawFull), wantFull)
	}
}

func TestDraftV2_UpsertPouObject_AutoExtractsInterface(t *testing.T) {
	service, projectID, draftID, etag := newV2Project(t)
	objectID := objectUUID(1)

	// Upsert POU without client interface
	stSource := "FUNCTION_BLOCK FB_Test\nVAR_INPUT\n    pv : REAL;\nEND_VAR\nVAR_OUTPUT\n    alarm : BOOL;\nEND_VAR\nEND_FUNCTION_BLOCK\n"
	opWithoutInterface := op(map[string]any{
		"op": "upsertObject",
		"object": map[string]any{
			"objectId": objectID,
			"kind":     "FUNCTION_BLOCK",
			"name":     "FB_Test",
			"language": "ST",
			"source":   stSource,
		},
	})

	result, err := saveOps(t, service, projectID, draftID, etag, "70000000-0000-4000-8000-000000000099", opWithoutInterface)
	if err != nil {
		t.Fatalf("saveOps without interface failed: %v", err)
	}

	doc := draftDocument(t, service, projectID)
	objects := collectionOf(doc, "objects")
	if len(objects) != 1 {
		t.Fatalf("expected 1 object, got %d", len(objects))
	}
	iface, ok := objects[0]["interface"].(map[string]any)
	if !ok {
		t.Fatalf("expected object.interface map, got: %T (%+v)", objects[0]["interface"], objects[0]["interface"])
	}
	inputs, ok := iface["inputs"].([]any)
	if !ok || len(inputs) != 1 {
		t.Fatalf("expected 1 input, got: %+v", iface["inputs"])
	}
	firstIn := inputs[0].(map[string]any)
	if firstIn["name"] != "pv" || firstIn["type"] != "REAL" {
		t.Fatalf("expected input pv:REAL, got: %+v", firstIn)
	}
	outputs, ok := iface["outputs"].([]any)
	if !ok || len(outputs) != 1 {
		t.Fatalf("expected 1 output, got: %+v", iface["outputs"])
	}
	firstOut := outputs[0].(map[string]any)
	if firstOut["name"] != "alarm" || firstOut["type"] != "BOOL" {
		t.Fatalf("expected output alarm:BOOL, got: %+v", firstOut)
	}

	// Upsert POU WITH client interface -> client interface must be preserved
	clientIface := map[string]any{
		"inputs": []map[string]any{{"name": "override_pin", "type": "INT"}},
	}
	opWithInterface := op(map[string]any{
		"op": "upsertObject",
		"object": map[string]any{
			"objectId":  objectID,
			"kind":      "FUNCTION_BLOCK",
			"name":      "FB_Test",
			"language":  "ST",
			"source":    stSource,
			"interface": clientIface,
		},
	})
	_, err = saveOps(t, service, projectID, draftID, result.ETag, "70000000-0000-4000-8000-000000000100", opWithInterface)
	if err != nil {
		t.Fatalf("saveOps with interface failed: %v", err)
	}

	doc2 := draftDocument(t, service, projectID)
	objects2 := collectionOf(doc2, "objects")
	iface2 := objects2[0]["interface"].(map[string]any)
	inputs2 := iface2["inputs"].([]any)
	if len(inputs2) != 1 || inputs2[0].(map[string]any)["name"] != "override_pin" {
		t.Fatalf("expected client-provided interface preserved, got: %+v", iface2)
	}
}
